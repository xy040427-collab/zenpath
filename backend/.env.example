# 志愿参谋 API 配置
APP_NAME=志愿参谋 API
API_PREFIX=/api/v1

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./gaokao.db

# DeepSeek AI (志愿推荐算法用)
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# CORS 允许来源 (逗号分隔)
CORS_ORIGINS=http://localhost:5173,http://localhost:3457,http://localhost:8000
